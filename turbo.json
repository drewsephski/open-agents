{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "BETTER_AUTH_SECRET",
        "CODESANDBOX_ENABLED",
        "CODESANDBOX_TEMPLATE_ID",
        "CSB_API_KEY",
        "BLOB_READ_WRITE_TOKEN",
        "ELEVENLABS_API_KEY",
        "ENCRYPTION_KEY",
        "GITHUB_CLIENT_SECRET",
        "JWE_SECRET",
        "KV_REST_API_READ_ONLY_TOKEN",
        "KV_REST_API_TOKEN",
        "KV_REST_API_URL",
        "KV_URL",
        "NEXT_PUBLIC_AUTH_PROVIDERS",
        "NEXT_PUBLIC_GITHUB_CLIENT_ID",
        "NEXT_PUBLIC_VERCEL_APP_CLIENT_ID",
        "POSTGRES_URL",
        "REDIS_URL",
        "SANDBOX_CIRCUIT_FAILURE_THRESHOLD",
        "SANDBOX_CIRCUIT_OPEN_MS",
        "SANDBOX_CIRCUIT_PROBE_LEASE_MS",
        "SANDBOX_CIRCUIT_WINDOW_MS",
        "SANDBOX_PROVIDER_ORDER",
        "VERCEL_SANDBOX_ENABLED",
        "VERCEL_APP_CLIENT_SECRET",
        "CREEM_API_KEY",
        "CREEM_MODE",
        "CREEM_PRO_PRODUCT_ID",
        "CREEM_WEBHOOK_SECRET",
        "PRO_CHECKOUT_ENABLED",
        "LAUNCHSTACK_APP_ORIGIN",
        "OPENROUTER_API_KEY",
        "OPENROUTER_MANAGEMENT_API_KEY",
        "OPENROUTER_PUBLIC_DEMO_API_KEY",
        "MANAGED_OPENROUTER_MODEL_IDS",
        "ENCRYPTION_KEY_VERSION",
        "ENCRYPTION_KEY_V1",
        "COMPOSIO_API_KEY",
        "COMPOSIO_GMAIL_AUTH_CONFIG_ID",
        "COMPOSIO_LINEAR_AUTH_CONFIG_ID"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "outputs": []
    }
  }
}
