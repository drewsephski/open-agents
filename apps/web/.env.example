# Minimum runtime
POSTGRES_URL=
BETTER_AUTH_SECRET=

# Provider credential encryption (generate with: openssl rand -base64 32)
# Increment the version when rotating. Retain earlier keys as ENCRYPTION_KEY_V1,
# ENCRYPTION_KEY_V2, and so on until all matching ciphertext is re-encrypted.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# OpenRouter operational configuration. Authenticated product inference uses
# encrypted User BYOK credentials instead of OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
# Optional, narrowly scoped key for the public stack recommendation demo.
OPENROUTER_PUBLIC_DEMO_API_KEY=
OPENROUTER_MODEL=openai/gpt-6.1-sol
# Optional comma-separated managed catalog. GLM 5.3 Flash is always included.
MANAGED_OPENROUTER_MODEL_IDS=openai/gpt-6.1-sol
# Management-only credential for provisioning limited User subkeys. This key is
# never used for model completion requests.
OPENROUTER_MANAGEMENT_API_KEY=

# Pro billing through Creem (test and live keys are separate).
CREEM_API_KEY=
CREEM_MODE=live
# Set true only AFTER Creem approves and enables live payments.
CREEM_LIVE_PAYMENTS_ENABLED=false
CREEM_PRO_PRODUCT_ID=
CREEM_WEBHOOK_SECRET=
# Checkout validates billing, webhook, and credential encryption configuration.
# Test keys require CREEM_MODE=test and a separate test database.
LAUNCHSTACK_APP_ORIGIN=https://launchstack.sh

# Vercel OAuth (required for sign-in)
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# GitHub App (required for repo access, pushes, and PRs)
# Callback URL: {YOUR_ORIGIN}/api/auth/callback/github (better-auth)
# Setup URL:    {YOUR_ORIGIN}/api/github/app/callback (installation sync)
# In the GitHub App settings:
#   1. Use the GitHub App Client ID and Client Secret below
#   2. Make the app public if you want org installs to work cleanly
#   3. Store the private key either as PEM contents with escaped newlines
#      or as a base64-encoded PEM
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Optional integrations
ELEVENLABS_API_KEY=
# Server-only Composio project key. Enables registered Gmail and Linear connections/actions.
# Never forward this key (or connected-account credentials) to a coding sandbox.
COMPOSIO_API_KEY=
# Optional custom Gmail auth config; omit to use Composio managed authentication.
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
# Optional custom Linear auth config; omit to use Composio managed authentication.
COMPOSIO_LINEAR_AUTH_CONFIG_ID=

# Optional Redis / Vercel KV (skills metadata cache; falls back to in-memory when not set)
REDIS_URL=
KV_URL=

# Optional deployment refinements
# Leave unset (or set to "hobby") for Hobby-compatible resource defaults.
# Set to "standard" for longer-running sandboxes on paid Vercel plans.
OPEN_AGENTS_RESOURCE_PROFILE=
VERCEL_PROJECT_PRODUCTION_URL=
NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=
# Optional base snapshot for fresh sandboxes. If unset, sandboxes use Vercel's standard Sandbox runtime.
# Use a snapshot created in/accessible to your own Vercel scope.
VERCEL_SANDBOX_BASE_SNAPSHOT_ID=

# Sandbox provider selection. Vercel remains primary. CodeSandbox is included
# automatically only when CSB_API_KEY is present.
SANDBOX_PROVIDER_ORDER=vercel,codesandbox
VERCEL_SANDBOX_ENABLED=true
# Set false to disable fallback instantly. When omitted, a key enables it.
# CODESANDBOX_ENABLED=true
CSB_API_KEY=
CODESANDBOX_TEMPLATE_ID=
# Short-lived, database-backed provider circuit breaker.
SANDBOX_CIRCUIT_FAILURE_THRESHOLD=3
SANDBOX_CIRCUIT_WINDOW_MS=300000
SANDBOX_CIRCUIT_OPEN_MS=120000
SANDBOX_CIRCUIT_PROBE_LEASE_MS=30000
